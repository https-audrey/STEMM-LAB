{
  "expo": {
    "name": "stemm-lab",
    "slug": "stemm-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e1a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.stemmlab.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.googaagee.stemmlab"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow STEMM Lab to use your camera for recording experiments.",
          "microphonePermission": "Allow STEMM Lab to record audio for your experiments.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow STEMM Lab to access your location for mapping sound zones.",
          "locationWhenInUsePermission": "Allow STEMM Lab to use your location while using the app."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow STEMM Lab to measure sound levels for the Sound Pollution Hunter activity."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "df117851-0f41-4278-86fd-4b6f15798918"
      }
    }
  }
}
